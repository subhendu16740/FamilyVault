{
  "name": "familyvault-qa",
  "private": true,
  "description": "Automated QA for FamilyVault: uploads synthetic SPECIMEN documents to the DEV project, asks questions about them, and checks the answers. Never touches PROD data.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "qa": "node run.mjs",
    "plan": "node run.mjs --plan",
    "selftest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/selftest.mjs",
    "fixtures": "node tools/generate-fixtures.mjs",
    "check:fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/check-fixtures.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "pdfjs-serverless": "1.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.2.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "playwright": "1.56.1"
  }
}
